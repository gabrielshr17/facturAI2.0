# Copiar a .env (mismo directorio) y rellenar con los valores reales antes de
# compilar/correr la PWA. Sin estas variables, la app sigue funcionando en
# modo 100% offline (PIN local, sql.js/IndexedDB) pero la sincronización en
# segundo plano hacia Supabase no arranca (queda logueado un error y la app
# sigue usable).
#
# Vite solo expone al navegador las variables con prefijo VITE_, y las
# embebe en el bundle de producción (no hay backend propio que las esconda
# aquí). Mismos valores que packages/api/.env / packages/desktop/.env (ver
# esos archivos) más la identidad fija de sincronización.
#
# Nota de seguridad ya aceptada para packages/desktop/.env y extendida acá:
# enviar la contraseña de la identidad de sincronización dentro de un bundle
# de cliente es una compensación (tradeoff) inherente al diseño de identidad
# compartida (una sola cuenta de Supabase Auth para sincronizar todas las
# cajas, en vez de una identidad por caja). Es una decisión arquitectónica ya
# tomada, no un descuido — no se resuelve inventando aquí un esquema de auth
# más complejo.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Identidad de Supabase Auth fija para sincronización en segundo plano.
# NUNCA se muestra a un usuario humano ni se usa para autenticación de
# cajero/dueño — solo la usa packages/core/src/sync/subida-saliente.ts.
VITE_SYNC_EMAIL=
VITE_SYNC_PASSWORD=
