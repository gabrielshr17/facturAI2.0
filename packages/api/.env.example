# Copiar a .env y rellenar cuando exista un proyecto real. Sin estas
# variables, el backend arranca igual mode "scaffold": /health responde,
# pero auth y transmisión e-CF devuelven placeholders (ver README.md).

PORT=3001

# Proyecto de Supabase (SOLO auth/autorización, ver plan.md decisión #2).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Proyecto de PowerSync (sync motor para multi-caja/multiusuario).
POWERSYNC_URL=

# Identidad de Supabase Auth fija y compartida entre TODAS las cajas, usada
# solo en segundo plano para autenticar la conexion de sync con PowerSync.
# Ver docs/sync-identity.md para el runbook de rotacion.
SYNC_EMAIL=
SYNC_PASSWORD=

# Orígenes permitidos por CORS (separados por coma). Incluir web y el origin
# Tauri de escritorio. Vacío = modo scaffold (refleja todo, con warning).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,tauri://localhost,http://tauri.localhost

# Chatbot con visión (Fase 3). Sin esto, /chatbot/* responde 501.
ANTHROPIC_API_KEY=
