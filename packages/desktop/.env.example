# Copiar a .env (mismo directorio) y rellenar con los valores reales antes de
# compilar/correr la caja física. Sin estas variables, la app sigue
# funcionando en modo 100% offline (PIN local, SQLite local) pero la
# sincronización en segundo plano hacia Supabase no arranca (queda logueado
# un error y la app sigue usable).
#
# packages/desktop es su propio proyecto Vite (ver vite.config.ts) igual que
# packages/web, así que Vite expone al frontend cualquier variable con
# prefijo VITE_ de este archivo vía import.meta.env — no hace falta nada del
# lado de Rust/Tauri (ver packages/core/src/sync/subida-saliente.ts, que
# corre igual en el webview de escritorio que en la PWA).
#
# Mismos valores que packages/api/.env / packages/web/.env (ver esos
# archivos) más la identidad fija de sincronización.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Identidad de Supabase Auth fija y compartida entre TODAS las cajas, usada
# solo en segundo plano para subir ventas/compras/inventario a Supabase.
# NUNCA se muestra a un usuario humano ni se usa para autenticación de
# cajero/dueño — solo la usa packages/core/src/sync/subida-saliente.ts.
# Ver docs/sync-identity.md para el runbook de rotación.
VITE_SYNC_EMAIL=
VITE_SYNC_PASSWORD=
