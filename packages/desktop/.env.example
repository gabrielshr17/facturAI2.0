# Copiar a .env (mismo directorio) y rellenar con los valores reales antes
# de compilar/correr la caja física. Sin estas variables, la app de
# escritorio sigue funcionando en modo 100% offline (PIN local, SQLite
# local) pero la sincronización en segundo plano hacia Supabase/PowerSync no
# arranca (queda logueado un error y la app sigue usable).
#
# Estos valores NO se embeben en el binario: se leen en tiempo de ejecución
# (packages/desktop/src-tauri/src/lib.rs carga este archivo con dotenvy antes
# de que el plugin de PowerSync los necesite). En producción, prefiere
# inyectarlos como variables de entorno del sistema en vez de distribuir un
# .env real junto al instalador.
#
# Mismos valores que packages/api/.env (ver ese archivo) más la identidad fija
# de sincronización (compartida por todas las cajas, ver plan.md).

SUPABASE_URL=
SUPABASE_ANON_KEY=

POWERSYNC_URL=

# Identidad de Supabase Auth fija para sincronización en segundo plano.
# NUNCA se muestra a un usuario humano ni se usa para autenticación de
# cajero/dueño — solo la usa el conector de PowerSync en Rust.
SYNC_EMAIL=
SYNC_PASSWORD=
